# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never put a real key in THIS file.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS. Never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI (platform.openai.com -> API keys) ---
# Server-only. Used exclusively inside lib/ai/* which is marked "server-only".
OPENAI_API_KEY=sk-your-key-here

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Supabase dashboard -> Connect -> URI, session pooler) ---
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
